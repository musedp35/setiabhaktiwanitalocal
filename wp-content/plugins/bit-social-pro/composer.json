{
  "name": "bitapps/social-pro",
  "description": "An Integration plugin for wordpress",
  "license": "gpl-2",
  "require": {
    "php": ">=7.4",
    "bitapps/wp-validator": "^1.0.4",
    "bitapps/wp-database": "1.5",
    "bitapps/wp-kit": "^1.5",
    "typisttech/imposter-plugin": "^0.6.2"
  },
  "autoload": {
    "psr-4": {
      "BitApps\\SocialPro\\": "./backend/app",
      "BitApps\\SocialPro\\Utils\\": "./backend/_plugin-commons/src"
    }
  },
  "scripts": {
    "clean": "rm -rf ./vendor && rm composer.lock",
    "reset": "composer clean && composer install"
  },
  "config": {
    "allow-plugins": {
      "typisttech/imposter-plugin": true
    }
  },
  "extra": {
    "imposter": {
      "namespace": "BitApps\\SocialPro\\Deps\\"
    }
  }
}
